{
	# Только HTTP/1.1 и HTTP/2. HTTP/3 работает по UDP; приложение UDP-порты не занимает,
	# чтобы не делить их с другими службами сервера.
	servers {
		protocols h1 h2
	}
}

# Адрес сайта задаётся окружением: домен на сервере (сертификат Caddy получит сам)
# или `:80` на стенде для e2e.
{$SITE_ADDRESS:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(self), microphone=(), geolocation=()"
		-Server
	}

	handle /life-uploads/* {
        # Presigned multipart only. Private originals are served through the API.
        @write method PUT
        handle @write {
            request_body {
                max_size 8388608
            }
            reverse_proxy storage:3900
        }
        respond 405
    }

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle {
		root * /srv

		# `wasm-unsafe-eval` — только компиляция WebAssembly: на нём работает распознавание
		# штрихкодов там, где его нет в браузере. Скрипты по-прежнему только свои.
		header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"

		# Файлы с хэшем в имени не меняются никогда; оболочка и service worker — проверяются каждый раз,
		# иначе телефон не увидит новую версию.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@shell path / /index.html /sw.js /manifest.webmanifest
		header @shell Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}
}
