# Адрес сайта задаётся окружением: домен на сервере (сертификат Caddy получит сам)
# или `:80` на стенде для e2e.
{$SITE_ADDRESS:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(self), microphone=(), geolocation=()"
		-Server
	}

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle {
		root * /srv

		header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"

		# Файлы с хэшем в имени не меняются никогда; оболочка и service worker — проверяются каждый раз,
		# иначе телефон не увидит новую версию.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@shell path / /index.html /sw.js /manifest.webmanifest
		header @shell Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}
}
