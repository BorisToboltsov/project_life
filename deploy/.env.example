# Образец настроек сервера. Настоящий .env создаёт deploy/install.sh; в репозиторий он не попадает.

# Публичный домен: Caddy сам получит для него сертификат.
SITE_ADDRESS=life.example.com

# Адрес приложения целиком — для ссылок-приглашений из командной строки.
PUBLIC_URL=https://life.example.com

# Ключ подписи токенов входа, не короче 32 символов: openssl rand -hex 32
JWT_SECRET=

# Только буквы и цифры (пароль подставляется в URL): openssl rand -hex 24
POSTGRES_PASSWORD=

# Какую сборку запускать: latest — последняя из main, либо конкретный тег для отката.
IMAGE_TAG=latest

# Открытый ключ age, которым шифруются бэкапы. Закрытый ключ на сервере не хранится.
BACKUP_RECIPIENT=

# Сколько дней хранить бэкапы на сервере.
BACKUP_KEEP_DAYS=30

# Куда копировать бэкапы вне сервера: путь rclone (например, remote:life). Пусто — никуда.
BACKUP_REMOTE=
