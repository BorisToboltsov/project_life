#!/usr/bin/env bash
# Обновление приложения — запускает администратор: /opt/life/bin/life-update
# Скачивает образы; если они новее работающих, делает бэкап базы и перезапускает
# контейнеры на них. Само по себе приложение не обновляется.
# Меняются только образы — compose.yaml и эти скрипты обновляет deploy/install.sh.
set -euo pipefail

LIFE_HOME="${LIFE_HOME:-/opt/life}"
cd "$LIFE_HOME"

# --progress quiet: вывод скрипта — его собственные строки, без хода загрузки образов.
compose() { docker compose --progress quiet --env-file .env -f compose.yaml "$@"; }
log() { printf '%s life-update: %s\n' "$(date -u +%FT%TZ)" "$*"; }

# Одновременно работает один экземпляр: два запуска не должны поднимать контейнеры
# наперегонки. Второй ждёт первого и затем обычно не находит, что обновлять.
exec 9>"$LIFE_HOME/.update.lock"
flock 9

compose pull

# Какие образы нужны по compose.yaml и на каких сейчас работают контейнеры.
wanted="$(compose config --images | while read -r image; do
  docker image inspect --format '{{.Id}}' "$image"
done | sort -u)"
running="$(compose ps --quiet | while read -r container; do
  docker inspect --format '{{.Image}}' "$container"
done | sort -u)"

version() { compose exec -T backend python -c 'import app; print(app.__version__)'; }

if [ -n "$running" ] && [ -z "$(comm -23 <(printf '%s\n' "$wanted") <(printf '%s\n' "$running"))" ]; then
  log "обновлять нечего, работает версия $(version)"
  exit 0
fi

# База уже работает — значит, в ней могут быть данные: сначала бэкап, потом миграции.
# Не удался бэкап — обновления не будет.
if [ -n "$(compose ps --quiet db)" ]; then
  log "есть новые образы, делаю бэкап перед обновлением"
  "$LIFE_HOME/bin/life-backup" pre-update >/dev/null
fi

log "запускаю контейнеры"
compose up --detach --wait --remove-orphans
docker image prune --force >/dev/null
log "работает версия $(version)"
